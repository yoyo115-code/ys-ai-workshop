APP_ENV=development
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
PRIMARY_LLM_PROVIDER=deepseek
AI_LABS_ENABLED=true
# Optional local bootstrap; production values belong in a Secret Manager.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
DATABASE_URL=sqlite:///./platform.db
CORS_ORIGINS=
SESSION_SECRET=
SESSION_HOURS=12
SESSION_COOKIE_NAME=ys_ai_session
SESSION_COOKIE_SECURE=false
REGISTRATION_MODE=open
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
STORAGE_PROVIDER=local
RESUME_EXPORT_DIR=
EXPORT_RETENTION_DAYS=7
# Production-only when STORAGE_PROVIDER=s3.
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_URL_SECONDS=300
CAREER_ANALYSIS_DAILY_LIMIT=2
SUGGESTION_GENERATION_DAILY_LIMIT=2
SUGGESTION_REGENERATION_DAILY_LIMIT=8
RESUME_EXPORT_DAILY_LIMIT=5
MAX_RESUME_CHARACTERS=20000
MAX_JOB_DESCRIPTION_CHARACTERS=20000
ADMIN_DAILY_LIMIT_EXEMPT=false
