APP_ENV=development
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Optional local bootstrap; production values belong in a Secret Manager.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
DATABASE_URL=sqlite:///./platform.db
CORS_ORIGINS=
SESSION_SECRET=
REGISTRATION_MODE=open
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
STORAGE_PROVIDER=local
RESUME_EXPORT_DIR=
EXPORT_RETENTION_DAYS=7
# Production-only when STORAGE_PROVIDER=s3.
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_URL_SECONDS=300
